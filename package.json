{
  "name": "kaa-bot",
  "version": "2.0.0",
  "description": "Умный Telegram-бот: Claude Sonnet 4.6, долговременная память, vision, voice, audio",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "koleya:test": "node --test \"koleya/test/*.test.js\"",
    "koleya:check": "node koleya/scripts/check-facts.js",
    "koleya:sim": "node koleya/scripts/simulate.js 1000",
    "koleya:dev": "node koleya/scripts/dev-server.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "lodash.debounce": "^4.0.8",
    "node-telegram-bot-api": "^0.66.0",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0"
  },
  "license": "ISC",
  "devDependencies": {
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3"
  }
}
